# Normaliza fins de linha: LF no repositório, nativo no working tree.
* text=auto

*.cs        text diff=csharp
*.razor     text
*.csproj    text
*.props     text
*.targets   text
*.sln       text eol=crlf
*.slnf      text
*.md        text
*.json      text
*.yml       text
*.css       text
*.js        text
*.ps1       text eol=crlf
*.sh        text eol=lf
*.xml       text

*.pdf       binary
*.png       binary
*.ttf       binary
*.keystore  binary
