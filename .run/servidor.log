      SELECT "s1"."Id", "s1"."ClosedAtUtc", "s1"."SectorId", "s1"."ServiceDate", "s1"."StartedAtUtc", "s1"."Status", "s1"."UpdatedAtUtc", "s1"."Version", "s0"."SessionId", "s0"."BedId", "s0"."IsActiveInSession"
