<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Núcleo do cliente, independente de plataforma (net10.0 puro).

    Motivo de existir separado do projeto MAUI: os TFMs de MAUI
    (net10.0-android / net10.0-windows) não executam testes nem as
    ferramentas do EF Core. Mantendo aqui o banco local, o Outbox, o motor de
    sincronização, a autenticação offline e a resolução de horários de
    notificação, toda a lógica crítica fica testável e migrável.
    Ver docs/DECISIONS.md (D-004).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ChecklistPlantao.Client.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mesmo padrão do servidor: a verificação de esquema local é detalhe interno, e precisa ser
         exercitada diretamente pelos testes sem virar API pública. -->
    <InternalsVisibleTo Include="ChecklistPlantao.Client.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChecklistPlantao.Domain\ChecklistPlantao.Domain.csproj" />
    <ProjectReference Include="..\ChecklistPlantao.Application\ChecklistPlantao.Application.csproj" />
    <ProjectReference Include="..\ChecklistPlantao.Contracts\ChecklistPlantao.Contracts.csproj" />
    <!-- Implementa os contratos do cliente. NÃO referencia ChecklistPlantao.UI: o núcleo não
         precisa da biblioteca de componentes Razor. Ver docs/DECISIONS.md (D-023). -->
    <ProjectReference Include="..\ChecklistPlantao.Client.Abstractions\ChecklistPlantao.Client.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

</Project>
