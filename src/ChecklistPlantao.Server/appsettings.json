{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "ChecklistPlantao": "Information"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "Path": "data/checklistplantao.db",
    "EnableWriteAheadLogging": true,
    "MigrateOnStartup": true,
    "SeedOnStartup": true,
    "BusyTimeoutSeconds": 15
  },

  "Jwt": {
    "Issuer": "ChecklistPlantao",
    "Audience": "ChecklistPlantao.Client",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 30
  },

  "Lockout": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },

  "Maintenance": {
    "IntervalMinutes": 30,
    "ChangeLogRetentionDays": 30,
    "ProcessedOperationRetentionDays": 7,
    "DeviceInactivityDays": 30
  },

  "RateLimit": {
    "LoginPerMinute": 20,
    "SyncBurst": 60,
    "SyncPerMinute": 30
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "Privacy": {
    "ContactEmail": "",
    "SupportUrl": "https://github.com/DiogoJP202/MedicMark/issues"
  }
}
