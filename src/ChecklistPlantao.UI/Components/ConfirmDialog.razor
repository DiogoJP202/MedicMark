@*
    Confirmação para ações destrutivas — e SOMENTE para elas.

    O enunciado é explícito: nada de modal a cada marcação. Este componente existe para fechar
    sessão, reiniciar checklist, desativar setor ou leito e excluir configuração.
*@

@if (Visible)
{
    <div class="modal-fundo" role="presentation" @onclick="CancelarAsync">
        <div class="modal"
             role="alertdialog"
             aria-modal="true"
             aria-labelledby="confirm-titulo"
             data-testid="confirm-dialog"
             @onclick:stopPropagation="true">
            <h2 class="modal__titulo" id="confirm-titulo">@Title</h2>

            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <p>@Message</p>
            }

            @ChildContent

            <div class="modal__acoes">
                <button type="button" class="botao botao--contorno" @onclick="CancelarAsync">@CancelText</button>
                <button type="button"
                        class="botao @(Destructive ? "botao--perigo" : "botao--primario")"
                        data-testid="confirm-accept"
                        @onclick="ConfirmarAsync">
                    @ConfirmText
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public string ConfirmText { get; set; } = "Confirmar";

    [Parameter]
    public string CancelText { get; set; } = "Cancelar";

    [Parameter]
    public bool Destructive { get; set; } = true;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private async Task ConfirmarAsync()
    {
        await VisibleChanged.InvokeAsync(false);
        await OnConfirm.InvokeAsync();
    }

    private async Task CancelarAsync()
    {
        await VisibleChanged.InvokeAsync(false);
        await OnCancel.InvokeAsync();
    }
}
