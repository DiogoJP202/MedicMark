<div class="estado-erro" role="alert" data-testid="error-state">
    <Icone Nome="erro" Class="estado-erro__icone" />
    <p class="estado-erro__titulo">@Title</p>
    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <p>@Message</p>
    }
    @if (OnRetry.HasDelegate)
    {
        <button type="button" class="botao botao--contorno" @onclick="OnRetry">Tentar de novo</button>
    }
</div>

@code {
    [Parameter]
    public string Title { get; set; } = "Não foi possível carregar";

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public EventCallback OnRetry { get; set; }
}
