@*
    Conjunto de ícones do aplicativo.

    Nasceu dentro do IslandNav, como métodos privados, e saiu de lá quando o resto da interface
    ainda usava glifos de texto — `▲`, `✕`, `✓`, `!` — para a mesma função. Eram duas linguagens
    visuais para a mesma coisa.

    Glifo de texto tem dois problemas que o SVG não tem: ele herda a fonte do sistema, e desenha
    diferente entre Android e Windows; e o tamanho depende da métrica da fonte, não do valor que
    você pediu.

    NÃO substitui o `✕` das células do checklist. Aquilo não é ícone de interface: é a notação da
    folha de papel que o sistema substitui — marcar um X na célula. Trocar por um desenho de
    "check" romperia a correspondência com o que o plantão já conhece.
*@

<span class="icone @(Class)" aria-hidden="true">
    <svg viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="@Traco"
         stroke-linecap="round"
         stroke-linejoin="round"
         focusable="false">
        @((MarkupString)Desenho(Nome))
    </svg>
</span>

@code {
    [Parameter, EditorRequired]
    public string Nome { get; set; } = string.Empty;

    /// <summary>Espessura do traço. Ícone pequeno pede traço um pouco mais grosso para não sumir.</summary>
    [Parameter]
    public double Traco { get; set; } = 1.8;

    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Um nome desconhecido vira um círculo, e não uma exceção: um ícone errado numa faixa de
    /// erro não pode ser o motivo de a tela não abrir.
    /// </summary>
    public static string Desenho(string nome) => nome switch
    {
        // Navegação
        "painel" => """<path d="M4 13h6V4H4v9Zm0 7h6v-5H4v5Zm10 0h6v-9h-6v9Zm0-16v5h6V4h-6Z"/>""",
        "checklist" => """<path d="M4 6h10M4 12h10M4 18h10"/><path d="m17 5 2 2 3-3M17 11l2 2 3-3M17 17l2 2 3-3"/>""",
        "classificacoes" => """<path d="M3 7h13l5 5-5 5H3z"/><circle cx="7.5" cy="12" r="1.4"/>""",
        "pendencias" => """<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>""",
        "plantao" => """<path d="M5 4h14v16l-7-3.5L5 20z"/>""",
        "administracao" => """<circle cx="12" cy="12" r="3"/><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.2 5.2l2.1 2.1M16.7 16.7l2.1 2.1M18.8 5.2l-2.1 2.1M7.3 16.7l-2.1 2.1"/>""",

        // Estado e mensagem
        "seta" => """<path d="m6 9 6 6 6-6"/>""",
        "check" => """<path d="m5 13 4 4 10-10"/>""",
        "fechar" => """<path d="m6 6 12 12M18 6 6 18"/>""",
        "alerta" => """<path d="M12 4 2.8 20h18.4z"/><path d="M12 10v4"/><circle cx="12" cy="17" r=".6" fill="currentColor"/>""",
        "erro" => """<circle cx="12" cy="12" r="8.5"/><path d="m9 9 6 6M15 9l-6 6"/>""",
        "info" => """<circle cx="12" cy="12" r="8.5"/><path d="M12 11v5.5"/><circle cx="12" cy="7.8" r=".7" fill="currentColor"/>""",
        "vazio" => """<circle cx="12" cy="12" r="8.5" stroke-dasharray="3 3"/>""",
        "sino" => """<path d="M6 9a6 6 0 0 1 12 0c0 4 1.5 5.5 1.5 5.5h-15S6 13 6 9Z"/><path d="M10 18a2 2 0 0 0 4 0"/>""",

        // Tema
        "sol" => """<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3 7 7M17 17l1.7 1.7M18.7 5.3 17 7M7 17l-1.7 1.7"/>""",
        "lua" => """<path d="M20 14.6A8.6 8.6 0 0 1 9.4 4 8.5 8.5 0 1 0 20 14.6Z"/>""",
        "automatico" => """<circle cx="12" cy="12" r="8.5"/><path d="M12 3.5a8.5 8.5 0 0 1 0 17Z" fill="currentColor"/>""",

        // Conexão — cada estado tem forma própria, e não só cor
        "conectado" => """<circle cx="12" cy="12" r="4" fill="currentColor"/><path d="M4.5 8a11 11 0 0 1 15 0M7.5 11.5a7 7 0 0 1 9 0"/>""",
        "rede-local" => """<circle cx="12" cy="12" r="4" fill="currentColor"/><path d="M7.5 11.5a7 7 0 0 1 9 0"/>""",
        "sem-servidor" => """<path d="M12 4 2.8 20h18.4z"/><path d="M12 10v4"/><circle cx="12" cy="17" r=".6" fill="currentColor"/>""",
        "offline" => """<circle cx="12" cy="12" r="4"/><path d="m4 4 16 16"/>""",
        "sincronizando" => """<path d="M20 12a8 8 0 1 1-2.3-5.6"/><path d="M20 4v4h-4"/>""",

        _ => """<circle cx="12" cy="12" r="8.5"/>""",
    };
}
