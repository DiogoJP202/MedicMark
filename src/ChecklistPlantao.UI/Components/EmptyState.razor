<div class="estado-vazio" data-testid="empty-state">
    <Icone Nome="@Icon" Class="estado-vazio__icone" />
    <p class="estado-vazio__titulo">@Title</p>
    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <p>@Message</p>
    }
    @ChildContent
</div>

@code {
    [Parameter]
    /// <summary>Nome de um dos desenhos de <c>Icone</c>. "vazio" é o neutro.</summary>
    public string Icon { get; set; } = "vazio";

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
