@inherits LayoutComponentBase
@implements IDisposable

@inject IAppSession Session
@inject ISyncStatusService SyncStatus
@inject INotificationStatusService NotificationStatus
@inject NavigationManager Navigation

@*
    Casca do aplicativo.

    O topo concentra o que precisa estar sempre visível: setor atual e estado de sincronização.
    A faixa de saúde das notificações vem logo abaixo e não pode ser DISPENSADA enquanto houver
    problema — é requisito, não escolha de layout. Ela pode ser recolhida para uma linha, que
    continua visível e continua levando à correção.
*@

<div class="app-shell">
    <header class="app-topo">
        <h1 class="app-topo__titulo">
            @(Session.CurrentSectorName is { Length: > 0 } setor ? setor : "Checklist de Plantão")
        </h1>
        <SyncStatusIndicator Status="_sync" OnSyncNow="SincronizarAsync" />
    </header>

    @if (Session.IsAuthenticated)
    {
        <nav class="nav-principal" aria-label="Navegação principal">
            <NavLink class="nav-principal__item" href="/" Match="NavLinkMatch.All">Painel</NavLink>
            <NavLink class="nav-principal__item" href="/checklist">Checklist</NavLink>
            <NavLink class="nav-principal__item" href="/classificacoes">Classificações</NavLink>
            <NavLink class="nav-principal__item" href="/pendencias">Pendências</NavLink>
            <NavLink class="nav-principal__item" href="/sessao">Plantão</NavLink>
            @*
                "Dispositivo" saiu da barra a pedido: a tela continua existindo e é alcançada pelo
                cartão "Estado do dispositivo" no painel, além da faixa de saúde no topo. A lista
                administrativa de aparelhos é outra coisa, e mora em Configurações avançadas.
            *@
            <PermissionGuard Permission="@Permissions.AdminSettings" Access="Session.Access">
                <NavLink class="nav-principal__item" href="/admin">Administração</NavLink>
            </PermissionGuard>
        </nav>
    }

    <NotificationHealthBanner Status="_notificacoes"
                              OnFix="CorrigirNotificacoesAsync"
                              OnTest="TestarNotificacaoAsync" />

    <main class="app-conteudo">
        @if (Session.PermissionsAreStale)
        {
            <div class="faixa faixa--alerta" role="status">
                <span class="faixa__icone" aria-hidden="true">▲</span>
                <div class="faixa__conteudo">
                    <p class="faixa__titulo">Permissões podem estar desatualizadas</p>
                    <p class="faixa__texto">
                        Este dispositivo está usando as permissões da última sincronização.
                        Conecte-se ao servidor para atualizá-las.
                    </p>
                </div>
            </div>
        }

        @*
            Uma tela que falha NÃO pode derrubar o aplicativo inteiro.

            Sem esta barreira, qualquer exceção de página encerrava o renderizador do Blazor: a
            interface toda morria, sobrava o aviso cru do host, e o único caminho era recarregar
            o WebView — que trava em "Carregando…" quando o estado já está quebrado.

            Com a barreira, o erro fica CONTIDO no conteúdo: a barra do topo e a navegação
            continuam funcionando, e o usuário sai da tela quebrada por conta própria.
        *@
        <ErrorBoundary @ref="_barreira">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="erro">
                <div class="cartao" role="alert" data-testid="page-error">
                    <h2 class="cartao__titulo">Esta tela não pôde ser aberta</h2>

                    <p>
                        Houve uma falha ao montar esta tela. <strong>Suas marcações continuam
                        salvas neste aparelho</strong> e serão enviadas normalmente.
                    </p>

                    <div class="linha">
                        <button type="button" class="botao botao--primario" @onclick="TentarNovamente">
                            Tentar de novo
                        </button>
                        <button type="button" class="botao botao--contorno" @onclick="VoltarAoInicio">
                            Voltar ao início
                        </button>
                    </div>

                    @* Detalhe técnico recolhido: ajuda no diagnóstico sem assustar quem só quer trabalhar. *@
                    <details style="margin-top:var(--esp-4)">
                        <summary class="campo__ajuda">Detalhes técnicos</summary>
                        <p class="campo__ajuda" data-testid="page-error-detail">@Detalhar(erro)</p>
                    </details>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </main>
</div>

@code {
    /// <summary>
    /// Mensagem de cada exceção da cadeia, e não só a de fora.
    ///
    /// A de fora costuma ser inútil para diagnosticar: "An error occurred while saving the entity
    /// changes. See the inner exception for details." é literalmente um pedido para ver a
    /// interna — que ficava escondida justamente quando a falha só acontece em uso real.
    /// </summary>
    private static string Detalhar(Exception erro)
    {
        var partes = new List<string>();

        for (Exception? atual = erro; atual is not null; atual = atual.InnerException)
        {
            partes.Add($"{atual.GetType().Name}: {atual.Message}");
        }

        return string.Join(" → ", partes);
    }

    private SyncStatus _sync = ChecklistPlantao.Client.Abstractions.SyncStatus.Unknown;
    private NotificationStatus _notificacoes = ChecklistPlantao.Client.Abstractions.NotificationStatus.Unknown;

    private ErrorBoundary? _barreira;

    /// <summary>Remonta a tela atual. Serve para falha passageira, como uma consulta que expirou.</summary>
    private void TentarNovamente() => _barreira?.Recover();

    /// <summary>
    /// Saída garantida. Recupera a barreira ANTES de navegar: sem isso, a tela de erro
    /// continuaria exibida sobre o destino, e o usuário seguiria preso.
    /// </summary>
    private void VoltarAoInicio()
    {
        _barreira?.Recover();
        Navigation.NavigateTo("/");
    }

    protected override void OnInitialized()
    {
        _sync = SyncStatus.Current;
        _notificacoes = NotificationStatus.Current;

        SyncStatus.Changed += AoMudarSincronizacao;
        NotificationStatus.Changed += AoMudarNotificacoes;
        Session.Changed += AoMudarSessao;
    }

    private void AoMudarSincronizacao(SyncStatus status) =>
        _ = InvokeAsync(() => { _sync = status; StateHasChanged(); });

    private void AoMudarNotificacoes(NotificationStatus status) =>
        _ = InvokeAsync(() => { _notificacoes = status; StateHasChanged(); });

    private void AoMudarSessao() => _ = InvokeAsync(StateHasChanged);

    private Task SincronizarAsync() => SyncStatus.SyncNowAsync();

    private Task CorrigirNotificacoesAsync() => NotificationStatus.OpenSystemSettingsAsync();

    private Task TestarNotificacaoAsync() => NotificationStatus.SendTestNotificationAsync();

    public void Dispose()
    {
        SyncStatus.Changed -= AoMudarSincronizacao;
        NotificationStatus.Changed -= AoMudarNotificacoes;
        Session.Changed -= AoMudarSessao;
    }
}
