@page "/entrar"
@layout EmptyLayout

@inject IAppSession Session
@inject IServerConfigurationService ServerConfiguration
@inject ISyncStatusService SyncStatus
@inject NavigationManager Navigation

<PageTitle>Entrar</PageTitle>

@if (_carregandoDados)
{
    @*
        Entrou, e agora o aplicativo busca tudo de uma vez. Mostrar isto — em vez de abrir o
        painel vazio — é o que evita a pergunta "cadê os leitos?" no primeiro uso.
    *@
    <div class="app-conteudo" style="max-width:440px;margin:0 auto" data-testid="login-loading">
        <LoadingState Message="Carregando os dados do plantão…" />
        <p class="campo__ajuda" style="text-align:center">
            Setores, leitos, horários e classificações vêm do servidor uma única vez. A partir daí
            o aplicativo funciona sem rede.
        </p>
    </div>
}
else
{

<div class="app-conteudo" style="max-width:440px;margin:0 auto">
    <h1>Checklist de Plantão</h1>

    @*
        O caminho para a configuração precisa existir SEMPRE, e não apenas quando falta
        configurar. Quem digitou o endereço errado só descobre o engano aqui, na tela de login —
        e sem esta saída fica preso: a configuração é alcançável de dentro do aplicativo, que
        exige entrar, que exige o servidor certo.
    *@
    @if (!ServerConfiguration.IsConfigured)
    {
        <div class="faixa faixa--alerta">
            <Icone Nome="alerta" Class="faixa__icone" />
            <div class="faixa__conteudo">
                <p class="faixa__titulo">Servidor não configurado</p>
                <p class="faixa__texto">Configure o endereço do servidor antes do primeiro acesso.</p>
                <button type="button"
                        class="botao botao--primario"
                        data-testid="login-configure-server"
                        @onclick="@(() => Navigation.NavigateTo("/configuracao"))">
                    Configurar servidor
                </button>
            </div>
        </div>
    }
    else
    {
        <p class="campo__ajuda" data-testid="login-server-line">
            <strong>Servidor configurado</strong>
            <button type="button"
                    class="botao botao--texto"
                    data-testid="login-configure-server"
                    @onclick="@(() => Navigation.NavigateTo("/configuracao"))">
                Configuração avançada
            </button>
        </p>
    }

    <EditForm Model="_modelo" OnValidSubmit="EntrarAsync">
        @*
            autocapitalize/autocorrect/spellcheck desligados: o teclado do Android capitaliza a
            primeira letra e "corrige" o que digita por padrão. Num campo de usuário ou senha isso
            produz uma credencial diferente da que a pessoa acha que digitou — e o erro só aparece
            como "usuário ou senha inválidos", sem pista nenhuma do que aconteceu.
        *@
        <div class="campo">
            <label class="campo__rotulo" for="usuario">Usuário</label>
            <InputText id="usuario"
                       class="campo__controle"
                       @bind-Value="_modelo.UserName"
                       autocomplete="username"
                       autocapitalize="none"
                       autocorrect="off"
                       spellcheck="false"
                       data-testid="login-user" />
        </div>

        <div class="campo">
            <label class="campo__rotulo" for="senha">Senha</label>
            <div class="linha" style="flex-wrap:nowrap;gap:var(--esp-2)">
                <InputText id="senha"
                           type="@(_mostrarSenha ? "text" : "password")"
                           class="campo__controle"
                           @bind-Value="_modelo.Password"
                           autocomplete="current-password"
                           autocapitalize="none"
                           autocorrect="off"
                           spellcheck="false"
                           data-testid="login-password" />
                @*
                    Conferir a senha digitada é o que evita a espiral de tentativas que termina em
                    conta bloqueada — especialmente em teclado de celular, de madrugada.
                *@
                <button type="button"
                        class="botao botao--contorno"
                        data-testid="login-toggle-password"
                        aria-pressed="@_mostrarSenha.ToString().ToLowerInvariant()"
                        title="@(_mostrarSenha ? "Ocultar a senha" : "Mostrar a senha")"
                        @onclick="() => _mostrarSenha = !_mostrarSenha">
                    @(_mostrarSenha ? "Ocultar" : "Mostrar")
                </button>
            </div>
        </div>

        @if (_erro is not null)
        {
            <div class="faixa faixa--erro" role="alert" data-testid="login-error">
                <Icone Nome="erro" Class="faixa__icone" />
                <div class="faixa__conteudo">
                    <p class="faixa__texto">@_erro</p>
                    @if (_detalhe is not null)
                    {
                        <details class="faixa__detalhe">
                            <summary>Detalhes técnicos</summary>
                            <p class="faixa__tecnico">@_detalhe</p>
                        </details>
                    }
                </div>
            </div>
        }

        <button type="submit" class="botao botao--primario botao--bloco botao--grande" disabled="@_entrando" data-testid="login-submit">
            @(_entrando ? "Entrando…" : "Entrar")
        </button>
    </EditForm>

    <div class="cartao" style="margin-top:var(--esp-5)" data-testid="login-connection">
        <p class="faixa__texto">
            <strong>Estado da conexão:</strong>
            @(_verificando ? "Verificando o servidor…" : SyncStatus.Current.Headline)
        </p>
        @if (SyncStatus.Current.LastSyncAtUtc is { } ultima)
        {
            <p class="faixa__texto">Última sincronização: @ultima.ToLocalTime().ToString("dd/MM/yyyy HH:mm", CultureInfo.GetCultureInfo("pt-BR"))</p>
        }
        else
        {
            <p class="faixa__texto">Este dispositivo ainda não sincronizou.</p>
        }

        @* Só afirma "sem servidor" depois de ter medido — nunca antes. *@
        @if (!_verificando && SyncStatus.Current.Connectivity is ConnectivityState.Offline or ConnectivityState.ServerUnreachable)
        {
            <p class="faixa__texto">
                Sem servidor no momento. Se você já entrou neste aparelho antes e o acesso offline
                ainda é válido, é possível entrar normalmente.
            </p>
        }
    </div>

    <p class="campo__ajuda" style="text-align:center;margin-top:var(--esp-4)">
        Ao usar o aplicativo, seus dados são tratados conforme a
        <a href="/privacidade" data-testid="login-privacy-link">Política de Privacidade</a>.
    </p>
</div>
}

@code {
    private readonly LoginModel _modelo = new();
    private bool _entrando;
    private bool _carregandoDados;
    private string? _erro;

    /// <summary>Causa técnica, quando o motivo da recusa não basta para resolver.</summary>
    private string? _detalhe;

    // Começa verdadeiro: o estado inicial de SyncStatus não foi medido, e exibi-lo como "Offline"
    // seria afirmar algo que ninguém verificou.
    private bool _verificando = true;

    private bool _mostrarSenha;

    protected override async Task OnInitializedAsync()
    {
        // Já autenticado nesta tela significa que alguém chegou aqui por um caminho lateral —
        // um "Voltar", um deep link. Ficar numa tela de login que não pede nada seria um beco
        // sem saída, então o painel assume.
        if (Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }

        try
        {
            await SyncStatus.RefreshConnectivityAsync();
        }
        finally
        {
            _verificando = false;
        }
    }

    private sealed class LoginModel
    {
        public string UserName { get; set; } = string.Empty;

        public string Password { get; set; } = string.Empty;
    }

    private async Task EntrarAsync()
    {
        _entrando = true;
        _erro = null;
        _detalhe = null;

        try
        {
            if (await Session.SignInAsync(_modelo.UserName, _modelo.Password))
            {
                // Traz TUDO de uma vez, antes de mostrar o painel: setores, leitos, tipos,
                // horários, marcadores e a sessão do plantão. Sem isto o painel abria vazio e
                // exigia que a pessoa descobrisse sozinha que precisava tocar no indicador de
                // sincronização — um passo invisível, no momento em que ela menos conhece o app.
                _carregandoDados = true;
                StateHasChanged();

                await SyncStatus.SyncNowAsync();

                Navigation.NavigateTo("/", replace: true);
                return;
            }

            _erro = Session.LastSignInError ?? "Usuário ou senha inválidos.";
            _detalhe = Session.LastSignInErrorDetail;
        }
        catch (Exception excecao)
        {
            // Rede, serialização, armazenamento seguro: entrar é a única porta do aplicativo, e
            // deixar qualquer exceção escapar daqui tranca o usuário do lado de fora, com a tela
            // de "o aplicativo precisa ser reiniciado" e nenhuma pista do motivo.
            _erro = "Não foi possível entrar por uma falha inesperada neste aparelho.";
            _detalhe = $"{excecao.GetType().Name}: {excecao.Message}";
        }
        finally
        {
            _entrando = false;
        }
    }
}
