@page "/sessao"
@implements IDisposable

@inject IAppSession Session
@inject IChecklistStore Store
@inject ISyncStatusService SyncStatus

<PageTitle>Plantão</PageTitle>

<h2>Plantão do setor @Session.CurrentSectorName</h2>

@if (_carregando && _sessaoAtual is null)
{
    <LoadingState />
}
else if (_sessaoAtual is null)
{
    <EmptyState Icon="vazio" Title="Nenhum plantão aberto" Message="Abra um plantão para começar o checklist." />
}
else
{
    <div class="pilha">
        <div class="cartao">
            <p class="faixa__texto"><strong>Data do plantão:</strong> @_sessaoAtual.ServiceDate.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)</p>
            <p class="faixa__texto"><strong>Situação:</strong> <StatusBadge Text="@(_sessaoAtual.IsOpen ? "Aberto" : "Encerrado")" Tone="@(_sessaoAtual.IsOpen ? "sucesso" : "inativo")" /></p>
        </div>

        @if (_resumo is not null)
        {
            <div class="cartao cartao--destaque">
                <h3 class="cartao__titulo">Resumo</h3>
                <ChecklistProgress Label="Tarefas" Total="_resumo.Overall.Total" Completed="_resumo.Overall.Completed" />

                @if (_resumo.HasPending)
                {
                    <div class="faixa faixa--alerta" style="margin-top:var(--esp-3)" role="status">
                        <Icone Nome="alerta" Class="faixa__icone" />
                        <div class="faixa__conteudo">
                            <p class="faixa__titulo">@_resumo.Overall.Pending tarefa(s) pendente(s)</p>
                            <p class="faixa__texto">Encerrar assim mesmo exige confirmação.</p>
                        </div>
                    </div>
                }
            </div>

            <section aria-labelledby="resumo-tipos">
                <h3 id="resumo-tipos">Por tipo de checklist</h3>
                <div class="grade-cartoes grade-cartoes--compacta">
                    @foreach (var template in _resumo.Templates)
                    {
                        <article class="cartao"
                                 data-testid="@($"summary-template-{template.TemplateId}")"
                                 data-state="@template.Progress.State.ToString()">
                            <h4 class="cartao__titulo">@template.TemplateName</h4>
                            <StatusBadge Text="@StateLabel(template.Progress.State)" Tone="@StateTone(template.Progress.State)" />
                            <p class="faixa__texto">@template.Progress.Completed de @template.Progress.Total concluída(s)</p>
                            <p class="campo__ajuda">@template.Progress.Pending pendente(s)</p>
                        </article>
                    }
                </div>
            </section>

            @if (_resumo.Markers.Count > 0)
            {
                <section aria-labelledby="resumo-classificacoes">
                    <h3 id="resumo-classificacoes">Classificações</h3>
                    <div class="grade-cartoes grade-cartoes--compacta">
                        @foreach (var marcador in _resumo.Markers)
                        {
                            <article class="cartao" data-testid="@($"summary-marker-{marcador.MarkerDefinitionId}")">
                                <h4 class="cartao__titulo">@marcador.MarkerName</h4>
                                <p class="faixa__texto">@string.Join(", ", marcador.BedCodes)</p>
                            </article>
                        }
                    </div>
                </section>
            }
        }

        <PermissionGuard Permission="@Permissions.ChecklistClose" Access="Session.Access">
            <ChildContent>
                <div class="linha">
                    @if (_sessaoAtual.IsOpen)
                    {
                        <button type="button" class="botao botao--perigo" data-testid="close-session" @onclick="() => _confirmarFechamento = true">
                            Encerrar plantão
                        </button>
                        <button type="button" class="botao botao--contorno" data-testid="reset-session" @onclick="() => _confirmarReinicio = true">
                            Reiniciar checklist
                        </button>
                    }
                </div>
            </ChildContent>
            <Fallback>
                <p class="campo__ajuda">Você não tem permissão para encerrar ou reiniciar o plantão.</p>
            </Fallback>
        </PermissionGuard>

        @if (_mensagem is not null)
        {
            <div class="faixa faixa--info" role="status"><div class="faixa__conteudo"><p class="faixa__texto">@_mensagem</p></div></div>
        }
    </div>
}

<ConfirmDialog @bind-Visible="_confirmarFechamento"
               Title="@(_resumo?.HasPending == true ? "Encerrar com pendências?" : "Encerrar o plantão?")"
               Message="@MensagemFechamento"
               ConfirmText="Encerrar"
               OnConfirm="FecharAsync" />

<ConfirmDialog @bind-Visible="_confirmarReinicio"
               Title="Reiniciar o checklist?"
               Message="Todas as marcações voltam a pendente. As classificações dos leitos são mantidas."
               ConfirmText="Reiniciar"
               OnConfirm="ReiniciarAsync" />

@code {
    private readonly SemaphoreSlim _portaDeRecarga = new(1, 1);
    private readonly CancellationTokenSource _vida = new();
    private CurrentSessionView? _sessaoAtual;
    private SessionSummaryDto? _resumo;
    private bool _carregando = true;
    private bool _confirmarFechamento;
    private bool _confirmarReinicio;
    private bool _descartada;
    private string? _mensagem;

    private string MensagemFechamento => _resumo?.HasPending == true
        ? $"Ainda há {_resumo.Overall.Pending} tarefa(s) pendente(s). O plantão será encerrado mesmo assim."
        : "O checklist deste plantão será encerrado.";

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += AoMudarDados;
        Store.Changed += AoMudarDados;
        SyncStatus.Changed += AoMudarSincronizacao;
        await RecarregarAsync();
    }

    private static string StateLabel(ProgressState state) => state switch
    {
        ProgressState.Completed => "Concluído",
        ProgressState.Partial => "Parcial",
        _ => "Pendente",
    };

    private static string StateTone(ProgressState state) => state switch
    {
        ProgressState.Completed => "sucesso",
        ProgressState.Partial => "alerta",
        _ => "inativo",
    };

    private void AoMudarDados() => SolicitarRecarga();

    private void AoMudarSincronizacao(ChecklistPlantao.Client.Abstractions.SyncStatus _) => SolicitarRecarga();

    private void SolicitarRecarga()
    {
        if (_descartada)
        {
            return;
        }

        _ = InvokeAsync(RecarregarComTratamentoAsync);
    }

    private async Task RecarregarComTratamentoAsync()
    {
        try
        {
            await RecarregarAsync();
        }
        catch (OperationCanceledException) when (_vida.IsCancellationRequested)
        {
        }
        catch
        {
            _carregando = false;
            _mensagem = "Não foi possível atualizar o resumo agora.";
            StateHasChanged();
        }
    }

    private async Task RecarregarAsync()
    {
        await _portaDeRecarga.WaitAsync(_vida.Token);

        try
        {
            _carregando = true;

            if (Session.CurrentSectorId is not { } sectorId)
            {
                _sessaoAtual = null;
                _resumo = null;
                return;
            }

            var sessao = await Store.GetCurrentSessionAsync(sectorId, _vida.Token);
            var resumo = sessao is null
                ? null
                : await Store.GetSessionSummaryAsync(sessao.Id, _vida.Token);

            if (Session.CurrentSectorId != sectorId)
            {
                return;
            }

            _sessaoAtual = sessao;
            _resumo = resumo;
        }
        finally
        {
            _carregando = false;
            _portaDeRecarga.Release();
        }
    }

    private async Task FecharAsync()
    {
        if (_sessaoAtual is null)
        {
            return;
        }

        var ok = await Store.CloseSessionAsync(_sessaoAtual.Id, confirmWithPending: true, _vida.Token);
        _mensagem = ok
            ? "Plantão encerrado."
            : "Não foi possível encerrar agora. Tente novamente quando o servidor estiver acessível.";

        await RecarregarAsync();
    }

    private async Task ReiniciarAsync()
    {
        if (_sessaoAtual is null)
        {
            return;
        }

        var ok = await Store.ResetSessionAsync(_sessaoAtual.Id, _vida.Token);
        _mensagem = ok ? "Checklist reiniciado." : "Não foi possível reiniciar agora.";
        await RecarregarAsync();
    }

    public void Dispose()
    {
        if (_descartada)
        {
            return;
        }

        _descartada = true;
        Session.Changed -= AoMudarDados;
        Store.Changed -= AoMudarDados;
        SyncStatus.Changed -= AoMudarSincronizacao;
        _vida.Cancel();
        _vida.Dispose();
        GC.SuppressFinalize(this);
    }
}
