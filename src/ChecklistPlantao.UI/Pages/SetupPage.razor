@page "/configuracao"
@layout EmptyLayout

@inject IServerConfigurationService ServerConfiguration
@inject ISyncStatusService SyncStatus
@inject NavigationManager Navigation

@*
    Configuração inicial do dispositivo.

    O endereço do servidor é sempre configurável — nunca há "localhost" fixo no aplicativo, que
    roda em aparelhos diferentes da máquina do servidor.
*@

<PageTitle>Configuração do servidor</PageTitle>

<div class="app-conteudo" style="max-width:520px;margin:0 auto">
    <h1>Configuração inicial</h1>
    <p>Informe o endereço do servidor na rede da instituição e dê um nome a este aparelho.</p>

    <div class="campo">
        <label class="campo__rotulo" for="url">Endereço do servidor</label>
        <input id="url"
               class="campo__controle"
               type="url"
               inputmode="url"
               placeholder="http://192.168.0.10:5000"
               data-testid="setup-url"
               @bind="_url"
               @bind:event="oninput" />
        <span class="campo__ajuda">
            Use o endereço de rede do servidor, não "localhost". Em produção, prefira HTTPS.
        </span>
    </div>

    <div class="campo">
        <label class="campo__rotulo" for="dispositivo">Nome deste dispositivo</label>
        <input id="dispositivo" class="campo__controle" data-testid="setup-device" @bind="_nomeDispositivo" />
        <span class="campo__ajuda">Aparece no painel administrativo para identificar o aparelho.</span>
    </div>

    <div class="linha">
        <button type="button" class="botao botao--contorno" disabled="@_testando" @onclick="TestarAsync" data-testid="setup-test">
            @(_testando ? "Testando…" : "Testar conexão")
        </button>
        <button type="button" class="botao botao--primario" disabled="@(!_podeSalvar)" @onclick="SalvarAsync" data-testid="setup-save">
            Salvar
        </button>
        @if (ServerConfiguration.IsConfigured)
        {
            <button type="button" class="botao botao--texto" @onclick="@(() => _confirmarRedefinicao = true)">
                Redefinir
            </button>

            @*
                Saída sem salvar. Vai para "/" e não para "/entrar": quem já está autenticado
                seria jogado numa tela de login que não pede nada — outro beco sem saída. O
                painel decide o destino certo conforme haja sessão ou não.
            *@
            <button type="button"
                    class="botao botao--texto"
                    data-testid="setup-back"
                    @onclick="@(() => Navigation.NavigateTo("/"))">
                Voltar
            </button>
        }
    </div>

    @if (_resultado is not null)
    {
        <div class="faixa @(_sucesso ? "faixa--sucesso" : "faixa--erro")" role="status" data-testid="setup-result">
            <span class="faixa__icone" aria-hidden="true">@(_sucesso ? "✓" : "✕")</span>
            <div class="faixa__conteudo">
                <p class="faixa__texto">@_resultado</p>
            </div>
        </div>
    }

    @if (ServerConfiguration.IsConfigured)
    {
        <div class="cartao" style="margin-top:var(--esp-4)">
            <p class="faixa__texto"><strong>Servidor atual:</strong> @ServerConfiguration.ServerUrl</p>
            <p class="faixa__texto"><strong>Dispositivo:</strong> @ServerConfiguration.DeviceName</p>
        </div>
    }
</div>

<ConfirmDialog @bind-Visible="_confirmarRedefinicao"
               Title="Redefinir a configuração?"
               Message="O endereço do servidor será apagado deste aparelho. As alterações ainda não sincronizadas continuam salvas localmente."
               ConfirmText="Redefinir"
               OnConfirm="RedefinirAsync" />

@code {
    private string _url = string.Empty;
    private string _nomeDispositivo = string.Empty;
    private bool _testando;
    private bool _sucesso;
    private string? _resultado;
    private bool _confirmarRedefinicao;

    private bool _podeSalvar;

    protected override void OnInitialized()
    {
        _url = ServerConfiguration.ServerUrl ?? string.Empty;
        _nomeDispositivo = ServerConfiguration.DeviceName;
    }

    protected override void OnParametersSet() => AtualizarPodeSalvar();

    private void AtualizarPodeSalvar() =>
        _podeSalvar = !string.IsNullOrWhiteSpace(_url) && !string.IsNullOrWhiteSpace(_nomeDispositivo);

    private async Task TestarAsync()
    {
        _testando = true;
        _resultado = null;

        try
        {
            var resposta = await ServerConfiguration.TestConnectionAsync(_url.Trim());

            if (resposta is null)
            {
                _sucesso = false;
                _resultado = "Não foi possível falar com o servidor neste endereço.";
                return;
            }

            _sucesso = true;
            _resultado = $"Conectado a {resposta.Application} ({resposta.Environment}). Fuso do servidor: {resposta.TimeZoneId}.";
        }
        finally
        {
            _testando = false;
            AtualizarPodeSalvar();
        }
    }

    private async Task SalvarAsync()
    {
        await ServerConfiguration.SaveAsync(_url.Trim(), _nomeDispositivo.Trim());

        // O endereço acabou de mudar: mede o alcance com ele antes de sair da tela, para que a
        // entrada já mostre um estado verificado em vez do inicial.
        await SyncStatus.RefreshConnectivityAsync();

        Navigation.NavigateTo("/entrar", replace: true);
    }

    private async Task RedefinirAsync()
    {
        await ServerConfiguration.ResetAsync();
        _url = string.Empty;
        _resultado = null;
        AtualizarPodeSalvar();
    }
}
