@page "/admin/marcadores"

@inject IStructureAdminService Admin

<PageTitle>Marcadores</PageTitle>

<AdminPageHeader Title="Marcadores de leito"
                 Description="C.I., Sondas e Drenos são os marcadores iniciais; outros podem ser criados."
                 BackHref="/admin/sistema">
    <Actions>
        <button type="button" class="botao botao--primario" data-testid="marker-new" @onclick="Novo">Novo marcador</button>
    </Actions>
</AdminPageHeader>

<AdminFeedback Result="_resultado" />

@if (_marcadores.Count == 0 && !_carregando)
{
    <EmptyState Icon="vazio" Title="Nenhum marcador cadastrado" Message="Crie um marcador para classificar leitos durante o plantão." />
}
else
{
    <div class="linha" style="margin-bottom:var(--esp-3)">
        <span class="campo__ajuda">O código é a referência estável sincronizada nos dispositivos.</span>
        <HelpPopover Label="Ajuda sobre o código estável">Renomear um marcador não altera seu código nem perde classificações já sincronizadas.</HelpPopover>
    </div>

    <div class="lista-responsiva">
        <div class="lista-responsiva__tabela tabela__area">
            <table class="tabela">
                <thead><tr><th>Marcador</th><th>Código</th><th>Ordem</th><th>Situação</th><th></th></tr></thead>
                <tbody>
                    @foreach (var marcador in _marcadores.OrderBy(m => m.SortOrder))
                    {
                        <tr data-testid="@($"marker-row-{marcador.Id}")">
                            <td>@marcador.Name</td>
                            <td><code>@marcador.Code</code></td>
                            <td>@marcador.SortOrder</td>
                            <td><StatusBadge Text="@(marcador.IsActive ? "Ativo" : "Desativado")" Tone="@(marcador.IsActive ? "sucesso" : "inativo")" /></td>
                            <td><button type="button" class="botao botao--texto" @onclick="() => Editar(marcador)">Editar</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="lista-responsiva__cards">
            @foreach (var marcador in _marcadores.OrderBy(m => m.SortOrder))
            {
                <article class="cartao admin-item" data-testid="@($"marker-card-{marcador.Id}")">
                    <div>
                        <strong>@marcador.Name</strong>
                        <span class="campo__ajuda"><code>@marcador.Code</code> · Ordem @marcador.SortOrder</span>
                    </div>
                    <StatusBadge Text="@(marcador.IsActive ? "Ativo" : "Desativado")" Tone="@(marcador.IsActive ? "sucesso" : "inativo")" />
                    <button type="button" class="botao botao--texto" @onclick="() => Editar(marcador)">Editar</button>
                </article>
            }
        </div>
    </div>
}

<FormDialog @bind-Visible="_modalAberto"
            Title="@(_editando is null ? "Novo marcador" : $"Editando: {_editando.Name}")"
            Saving="_salvando"
            OnSave="SalvarAsync">
    @* Dentro do modal: com o formulário aberto, uma faixa de erro atrás dele não seria vista. *@
    <AdminFeedback Result="_erroDoModal" />

    <div class="campo">
        <label class="campo__rotulo" for="marcador-nome">Nome</label>
        <input id="marcador-nome" class="campo__controle" data-testid="marker-name" @bind="_nome" />
    </div>

    <div class="linha">
        <div class="campo" style="flex:0 1 120px">
            <label class="campo__rotulo" for="marcador-ordem">Ordem</label>
            <input id="marcador-ordem" class="campo__controle" type="number" @bind="_ordem" />
        </div>
        <Caixa @bind-Value="_ativo" Label="Ativo" />
    </div>
</FormDialog>

<LoadingOverlay Visible="_carregando" Message="@_mensagemDeEspera" />

@code {
    private bool _carregando;
    private string _mensagemDeEspera = "Carregando os marcadores…";

    private IReadOnlyList<BedMarkerDefinitionDto> _marcadores = [];
    private BedMarkerDefinitionDto? _editando;
    private string _nome = string.Empty;
    private int _ordem = 10;
    private bool _ativo = true;
    private Result? _resultado;

    private bool _modalAberto;
    private bool _salvando;
    private Result? _erroDoModal;

    protected override async Task OnInitializedAsync() => await CarregarAsync();

    private async Task CarregarAsync()
    {
        _carregando = true;

        try
        {
            _marcadores = await Admin.GetMarkersAsync();
        }
        finally
        {
            _carregando = false;
        }
    }

    private void Novo()
    {
        _editando = null;
        _nome = string.Empty;
        _ordem = (_marcadores.Count + 1) * 10;
        _ativo = true;
        Abrir();
    }

    private void Editar(BedMarkerDefinitionDto marcador)
    {
        _editando = marcador;
        _nome = marcador.Name;
        _ordem = marcador.SortOrder;
        _ativo = marcador.IsActive;
        Abrir();
    }

    private void Abrir()
    {
        _erroDoModal = null;
        _resultado = null;
        _modalAberto = true;
    }

    private async Task SalvarAsync()
    {
        _salvando = true;

        try
        {
            var resultado = await Admin.SaveMarkerAsync(_editando?.Id, new SaveMarkerRequest(_nome, _ordem, _ativo, _editando?.Version ?? 0));

            if (!resultado.Succeeded)
            {
                // Modal aberto de propósito: o texto digitado continua ali para ser corrigido.
                _erroDoModal = resultado;
                return;
            }

            _resultado = resultado;
            _modalAberto = false;
            _erroDoModal = null;
            await CarregarAsync();
        }
        finally
        {
            _salvando = false;
        }
    }
}
