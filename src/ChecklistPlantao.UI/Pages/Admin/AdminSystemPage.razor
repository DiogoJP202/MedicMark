@page "/admin/notificacoes"
@page "/admin/configuracoes"
@page "/admin/dispositivos"

@inject IAdministrationService Admin
@inject NavigationManager Navigation

@*
    Notificações, configurações gerais e dispositivos. Três rotas na mesma página porque os
    três assuntos são curtos e frequentemente ajustados juntos.
*@

<PageTitle>Configurações do sistema</PageTitle>

<AdminFeedback Result="_resultado" />

<h2>Notificações</h2>

@if (_notificacoes is not null)
{
    <div class="cartao">
        <div class="linha">
            <label class="campo campo--horizontal">
                <input type="checkbox" style="width:24px;height:24px" data-testid="notif-sound" @bind="_som" />
                <span class="campo__rotulo">Som</span>
            </label>
            <label class="campo campo--horizontal">
                <input type="checkbox" style="width:24px;height:24px" @bind="_vibracao" />
                <span class="campo__rotulo">Vibração</span>
            </label>
            <label class="campo campo--horizontal">
                <input type="checkbox" style="width:24px;height:24px" @bind="_android" />
                <span class="campo__rotulo">Habilitado no Android</span>
            </label>
            <label class="campo campo--horizontal">
                <input type="checkbox" style="width:24px;height:24px" @bind="_windows" />
                <span class="campo__rotulo">Habilitado no Windows</span>
            </label>
        </div>

        <div class="campo" style="max-width:220px">
            <label class="campo__rotulo" for="prioridade">Prioridade</label>
            <select id="prioridade" class="campo__controle" @bind="_prioridade">
                <option value="Normal">Normal</option>
                <option value="High">Alta</option>
                <option value="Urgent">Urgente</option>
            </select>
        </div>

        <div class="campo">
            <label class="campo__rotulo" for="titulo">Modelo do título</label>
            <input id="titulo" class="campo__controle" @bind="_titulo" />
            <span class="campo__ajuda">Marcadores: {checklist}, {coluna}, {setor}, {pendentes}.</span>
        </div>

        <div class="campo">
            <label class="campo__rotulo" for="corpo">Modelo da mensagem</label>
            <input id="corpo" class="campo__controle" @bind="_corpo" />
        </div>

        <label class="campo campo--horizontal">
            <input type="checkbox" style="width:24px;height:24px" @bind="_telaCheia" />
            <span class="campo__rotulo">Permitir alerta em tela cheia no Android</span>
        </label>
        <p class="campo__ajuda">
            Desligado por padrão: exige permissão especial, é intrusivo e as lojas restringem o uso.
            Ative apenas se a instituição realmente precisar. Ver docs/NOTIFICATIONS.md.
        </p>

        <button type="button" class="botao botao--primario" data-testid="notif-save" @onclick="SalvarNotificacoesAsync">
            Salvar notificações
        </button>
    </div>
}

<h2 style="margin-top:var(--esp-6)">Configurações gerais</h2>

@if (_configuracoes is not null)
{
    <div class="cartao">
        <div class="campo" style="max-width:280px">
            <label class="campo__rotulo" for="fuso">Fuso horário</label>
            <input id="fuso" class="campo__controle" data-testid="settings-timezone" @bind="_fuso" />
            <span class="campo__ajuda">Identificador IANA, por exemplo America/Sao_Paulo.</span>
        </div>

        <div class="linha">
            <div class="campo" style="flex:0 1 150px">
                <label class="campo__rotulo" for="turno-inicio">Início do plantão</label>
                <input id="turno-inicio" class="campo__controle" type="time" data-testid="settings-shift-start" @bind="_inicio" />
            </div>
            <div class="campo" style="flex:0 1 150px">
                <label class="campo__rotulo" for="turno-fim">Fim do plantão</label>
                <input id="turno-fim" class="campo__controle" type="time" @bind="_fim" />
            </div>
        </div>
        <p class="campo__ajuda">
            Colunas com horário anterior ao início do turno pertencem ao dia seguinte —
            é assim que 00H, 02H, 04H e 06H ficam no mesmo plantão que 20H e 22H.
        </p>

        <div class="linha">
            <div class="campo" style="flex:0 1 190px">
                <label class="campo__rotulo" for="retencao">Recuperação após encerrar (h)</label>
                <input id="retencao" class="campo__controle" type="number" min="0" data-testid="settings-retention" @bind="_retencao" />
                <span class="campo__ajuda">Zero apaga imediatamente ao encerrar.</span>
            </div>
            <div class="campo" style="flex:0 1 180px">
                <label class="campo__rotulo" for="offline">Validade do acesso offline (dias)</label>
                <input id="offline" class="campo__controle" type="number" min="1" @bind="_offlineDias" />
            </div>
            <div class="campo" style="flex:0 1 180px">
                <label class="campo__rotulo" for="tentativas">Tentativas offline</label>
                <input id="tentativas" class="campo__controle" type="number" min="1" @bind="_tentativas" />
            </div>
        </div>

        <label class="campo campo--horizontal">
            <input type="checkbox" style="width:24px;height:24px" @bind="_abrirAutomaticamente" />
            <span class="campo__rotulo">Abrir o plantão automaticamente ao entrar no setor</span>
        </label>

        <button type="button" class="botao botao--primario" data-testid="settings-save" @onclick="SalvarConfiguracoesAsync">
            Salvar configurações
        </button>
    </div>
}

<h2 style="margin-top:var(--esp-6)">Dispositivos</h2>

<div class="faixa faixa--info">
    <span class="faixa__icone" aria-hidden="true">i</span>
    <div class="faixa__conteudo">
        <p class="faixa__texto">
            Os dados abaixo são o <strong>último estado sincronizado</strong> de cada aparelho.
            Um dispositivo totalmente offline não aparece atualizado aqui — o servidor não tem
            como saber o estado atual dele.
        </p>
    </div>
</div>

<div class="tabela__area">
    <table class="tabela">
        <thead>
            <tr><th>Dispositivo</th><th>Plataforma</th><th>Versão</th><th>Visto em</th><th>Notificações</th><th>Alarme exato</th><th>Situação</th></tr>
        </thead>
        <tbody>
            @foreach (var dispositivo in _dispositivos)
            {
                <tr>
                    <td>@dispositivo.DeviceName</td>
                    <td>@dispositivo.Platform</td>
                    <td>@dispositivo.AppVersion</td>
                    <td>@dispositivo.LastSeenAtUtc.ToLocalTime().ToString("dd/MM HH:mm", CultureInfo.GetCultureInfo("pt-BR"))</td>
                    <td>@dispositivo.NotificationHealth</td>
                    <td>@(dispositivo.ExactAlarmPermissionGranted is { } e ? (e ? "sim" : "não") : "—")</td>
                    <td>@(dispositivo.IsActive ? "ativo" : "inativo")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private NotificationConfigurationDto? _notificacoes;
    private InstitutionSettingsDto? _configuracoes;
    private IReadOnlyList<DeviceDto> _dispositivos = [];
    private Result? _resultado;

    private bool _som, _vibracao, _android, _windows, _telaCheia;
    private string _prioridade = "High";
    private string _titulo = string.Empty;
    private string _corpo = string.Empty;

    private string _fuso = string.Empty;
    private TimeOnly _inicio;
    private TimeOnly _fim;
    private int _retencao;
    private int _offlineDias;
    private int _tentativas;
    private bool _abrirAutomaticamente;

    protected override async Task OnInitializedAsync() => await CarregarAsync();

    private async Task CarregarAsync()
    {
        _notificacoes = await Admin.GetNotificationConfigurationAsync();
        _som = _notificacoes.SoundEnabled;
        _vibracao = _notificacoes.VibrationEnabled;
        _android = _notificacoes.EnabledOnAndroid;
        _windows = _notificacoes.EnabledOnWindows;
        _telaCheia = _notificacoes.AllowFullScreenIntent;
        _prioridade = _notificacoes.Priority;
        _titulo = _notificacoes.TitleTemplate;
        _corpo = _notificacoes.BodyTemplate;

        _configuracoes = await Admin.GetSettingsAsync();
        _fuso = _configuracoes.TimeZoneId;
        _inicio = _configuracoes.ShiftStart;
        _fim = _configuracoes.ShiftEnd;
        _retencao = _configuracoes.RetentionAfterCloseHours;
        _offlineDias = _configuracoes.OfflineLoginValidityDays;
        _tentativas = _configuracoes.OfflineLoginMaxAttempts;
        _abrirAutomaticamente = _configuracoes.AutoOpenSession;

        _dispositivos = await Admin.GetDevicesAsync();
    }

    private async Task SalvarNotificacoesAsync()
    {
        _resultado = await Admin.SaveNotificationConfigurationAsync(new SaveNotificationConfigurationRequest(
            _som, _vibracao, _prioridade, _android, _windows, _telaCheia, _titulo, _corpo, _notificacoes?.Version ?? 0));

        await CarregarAsync();
    }

    private async Task SalvarConfiguracoesAsync()
    {
        _resultado = await Admin.SaveSettingsAsync(new SaveInstitutionSettingsRequest(
            _fuso, _inicio, _fim, _retencao, _offlineDias, _tentativas, _abrirAutomaticamente));

        await CarregarAsync();
    }
}
