@page "/admin"

@inject IAppSession Session
@inject NavigationManager Navigation

@*
    Índice da administração. Cada cartão exige a permissão correspondente — não existe um
    "modo admin" que libera tudo de uma vez.
*@

<PageTitle>Administração</PageTitle>

<h2>Administração</h2>
<p>As alterações feitas aqui são sincronizadas para todos os dispositivos.</p>

<div class="grade-cartoes">
    @foreach (var item in Itens)
    {
        <PermissionGuard Permission="@item.Permission" Access="Session.Access">
            <button type="button" class="cartao cartao--acionavel" data-testid="@($"admin-{item.Route}")"
                    @onclick="@(() => Navigation.NavigateTo(item.Route))">
                <span class="cartao__titulo">@item.Title</span>
                <span class="faixa__texto">@item.Description</span>
            </button>
        </PermissionGuard>
    }
</div>

@code {
    private sealed record ItemAdmin(string Title, string Description, string Route, string Permission);

    private static readonly ItemAdmin[] Itens =
    [
        new("Setores e leitos", "Cadastrar, editar, reordenar, ativar e mover leitos.", "/admin/setores", Permissions.AdminSectors),
        new("Tipos de checklist", "Colunas, horários reais e parâmetros de notificação.", "/admin/templates", Permissions.AdminTemplates),
        new("Marcadores", "C.I., Sondas, Drenos e outras classificações de leito.", "/admin/marcadores", Permissions.AdminTemplates),
        new("Usuários e grupos", "Acesso por grupos, permissões e setores autorizados.", "/admin/acessos", Permissions.AdminUsers),
        new("Notificações", "Som, vibração, prioridade e textos dos alertas.", "/admin/notificacoes", Permissions.AdminNotifications),
        new("Configurações gerais", "Fuso horário, janela do plantão, retenção e acesso offline.", "/admin/configuracoes", Permissions.AdminSettings),
        new("Dispositivos", "Aparelhos conhecidos e o último estado sincronizado.", "/admin/dispositivos", Permissions.AdminDevices),
    ];
}
