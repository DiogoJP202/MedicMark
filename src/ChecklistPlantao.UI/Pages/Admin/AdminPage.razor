@page "/admin"

@inject IAppSession Session
@inject NavigationManager Navigation

@*
    Índice da administração.

    A porta principal é Configurações do sistema, que reúne tudo. Os dois atalhos abaixo existem
    porque setores e tipos de checklist são o que se mexe no dia a dia — enterrá-los dois níveis
    abaixo trocaria organização por atrito.
*@

<PageTitle>Administração</PageTitle>

<h2>Administração</h2>
<p>As alterações feitas aqui são sincronizadas para todos os dispositivos.</p>

<PermissionGuard Permission="@Permissions.AdminSettings" Access="Session.Access">
    <button type="button"
            class="cartao cartao--acionavel"
            data-testid="admin-configuracoes-sistema"
            @onclick="@(() => Navigation.NavigateTo("/admin/sistema"))">
        <span class="cartao__titulo">Configurações do Sistema</span>
        <span class="faixa__texto">
            Setores e leitos, tipos de checklist, marcadores e configurações avançadas.
        </span>
    </button>
</PermissionGuard>

<h3 style="margin-top:var(--esp-6)">Atalhos</h3>

<AdminMenu Items="Atalhos" Access="Session.Access" OnSelect="@(rota => Navigation.NavigateTo(rota))" />

@code {
    private static readonly AdminMenuItem[] Atalhos =
    [
        new("Setores e leitos", "Cadastrar, editar, reordenar, ativar e mover leitos.", "/admin/setores", Permissions.AdminSectors),
        new("Tipos de checklist", "Colunas, horários reais e parâmetros de notificação.", "/admin/templates", Permissions.AdminTemplates),
    ];
}
