@page "/admin/dispositivos"

@inject ISystemAdminService Admin

<PageTitle>Dispositivos</PageTitle>

<AdminPageHeader Title="Dispositivos"
                 Description="Consulte o último estado sincronizado dos aparelhos conhecidos."
                 BackHref="/admin/avancado" />

<div class="linha" style="margin-bottom:var(--esp-4)">
    <span class="campo__ajuda">Esta página é somente leitura.</span>
    <HelpPopover Label="Ajuda sobre o estado dos dispositivos">Um aparelho totalmente offline não consegue atualizar o servidor; por isso os dados representam sempre o último estado sincronizado, não necessariamente o estado atual.</HelpPopover>
</div>

@if (_dispositivos.Count == 0 && !_carregando)
{
    <EmptyState Title="Nenhum aparelho registrado"
                Message="Os dispositivos aparecem aqui depois da primeira sincronização com este servidor." />
}
else
{
    <div class="lista-responsiva" data-testid="devices-readonly-list">
        <div class="lista-responsiva__tabela tabela__area">
            <table class="tabela">
                <thead>
                    <tr><th>Dispositivo</th><th>Plataforma</th><th>Versão</th><th>Visto em</th><th>Notificações</th><th>Alarme exato</th><th>Situação</th></tr>
                </thead>
                <tbody>
                    @foreach (var dispositivo in _dispositivos)
                    {
                        <tr data-testid="@($"device-row-{dispositivo.Id}")">
                            <td>@dispositivo.DeviceName</td>
                            <td>@dispositivo.Platform</td>
                            <td>@dispositivo.AppVersion</td>
                            <td>@VistoEm(dispositivo)</td>
                            <td>@dispositivo.NotificationHealth</td>
                            <td>@AlarmeExato(dispositivo)</td>
                            <td><StatusBadge Text="@(dispositivo.IsActive ? "Ativo" : "Inativo")" Tone="@(dispositivo.IsActive ? "sucesso" : "inativo")" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="lista-responsiva__cards">
            @foreach (var dispositivo in _dispositivos)
            {
                <article class="cartao admin-dispositivo" data-testid="@($"device-card-{dispositivo.Id}")">
                    <div class="linha linha--entre">
                        <div>
                            <strong>@dispositivo.DeviceName</strong>
                            <span class="campo__ajuda">@dispositivo.Platform · versão @dispositivo.AppVersion</span>
                        </div>
                        <StatusBadge Text="@(dispositivo.IsActive ? "Ativo" : "Inativo")" Tone="@(dispositivo.IsActive ? "sucesso" : "inativo")" />
                    </div>
                    <dl class="admin-detalhes">
                        <dt>Visto em</dt><dd>@VistoEm(dispositivo)</dd>
                        <dt>Notificações</dt><dd>@dispositivo.NotificationHealth</dd>
                        <dt>Alarme exato</dt><dd>@AlarmeExato(dispositivo)</dd>
                    </dl>
                </article>
            }
        </div>
    </div>
}

<LoadingOverlay Visible="_carregando" Message="Carregando os dispositivos…" />

@code {
    private IReadOnlyList<DeviceDto> _dispositivos = [];
    private bool _carregando;

    protected override async Task OnInitializedAsync()
    {
        _carregando = true;
        try
        {
            _dispositivos = await Admin.GetDevicesAsync();
        }
        finally
        {
            _carregando = false;
        }
    }

    private static string VistoEm(DeviceDto dispositivo) =>
        dispositivo.LastSeenAtUtc.ToLocalTime().ToString("dd/MM HH:mm", CultureInfo.GetCultureInfo("pt-BR"));

    private static string AlarmeExato(DeviceDto dispositivo) =>
        dispositivo.ExactAlarmPermissionGranted is { } permitido ? (permitido ? "Sim" : "Não") : "—";
}
