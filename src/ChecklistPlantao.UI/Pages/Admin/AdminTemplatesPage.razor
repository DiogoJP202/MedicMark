@page "/admin/templates"

@inject IStructureAdminService Admin

@*
    Tipos de checklist e suas colunas.

    É aqui que "Jantar" deixa de ser só um rótulo: cada coluna tem horário real, e é ele que
    manda no agendamento das notificações em todos os dispositivos.
*@

<PageTitle>Tipos de checklist</PageTitle>

<AdminPageHeader Title="Tipos de checklist"
                 Description="Defina o que será conferido, quando e em quais setores."
                 BackHref="/admin/sistema">
    <Actions>
        <button type="button" class="botao botao--primario" data-testid="template-new" @onclick="NovoTemplate">Novo tipo</button>
    </Actions>
</AdminPageHeader>

<AdminFeedback Result="_resultado" />

@foreach (var template in _templates)
{
    <section class="cartao admin-entidade" style="margin-top:var(--esp-4)">
        <div class="linha linha--entre">
            <div>
                <div class="linha">
                    <h3 class="cartao__titulo">@template.Name</h3>
                    <StatusBadge Text="@(template.IsActive ? "Ativo" : "Desativado")" Tone="@(template.IsActive ? "sucesso" : "inativo")" />
                </div>
                <p class="campo__ajuda">
                    @(template.SectorIds.Count == 0 ? "Todos os setores" : $"{template.SectorIds.Count} setor(es)") · @template.Columns.Count coluna(s)
                </p>
            </div>
            <div class="linha">
                <button type="button" class="botao botao--texto" @onclick="() => EditarTemplate(template)">Editar tipo</button>
                <button type="button" class="botao botao--contorno" @onclick="() => NovaColuna(template)">Nova coluna</button>
            </div>
        </div>

        <details class="admin-expansivel">
            <summary>Gerenciar colunas</summary>
            <div class="lista-responsiva">
                <div class="lista-responsiva__tabela tabela__area">
                    <table class="tabela">
                        <thead>
                            <tr><th>Coluna</th><th>Horário</th><th>Ordem</th><th>Notifica</th><th>Situação</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var coluna in template.Columns.OrderBy(c => c.SortOrder))
                            {
                                <tr data-testid="@($"column-row-{coluna.Id}")">
                                    <td>@coluna.DisplayName</td>
                                    <td>@(coluna.TriggerTime is { } h ? h.ToString("HH':'mm", CultureInfo.InvariantCulture) : "sem horário")</td>
                                    <td>@coluna.SortOrder</td>
                                    <td>@(coluna.NotificationEnabled ? "Sim" : "Não")</td>
                                    <td><StatusBadge Text="@(coluna.IsActive ? "Ativa" : "Desativada")" Tone="@(coluna.IsActive ? "sucesso" : "inativo")" /></td>
                                    <td><button type="button" class="botao botao--texto" @onclick="() => EditarColuna(template, coluna)">Editar</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="lista-responsiva__cards">
                    @foreach (var coluna in template.Columns.OrderBy(c => c.SortOrder))
                    {
                        <article class="admin-item" data-testid="@($"column-card-{coluna.Id}")">
                            <div>
                                <strong>@coluna.DisplayName</strong>
                                <span class="campo__ajuda">@(coluna.TriggerTime is { } h ? h.ToString("HH':'mm", CultureInfo.InvariantCulture) : "Sem horário") · Ordem @coluna.SortOrder</span>
                            </div>
                            <StatusBadge Text="@(coluna.IsActive ? "Ativa" : "Desativada")" Tone="@(coluna.IsActive ? "sucesso" : "inativo")" />
                            <button type="button" class="botao botao--texto" @onclick="() => EditarColuna(template, coluna)">Editar</button>
                        </article>
                    }
                </div>
            </div>
        </details>
    </section>
}

<FormDialog @bind-Visible="_modalTemplate"
            Title="@(_templateEditando is null ? "Novo tipo de checklist" : $"Editando: {_templateEditando.Name}")"
            Saving="_salvando"
            OnSave="SalvarTemplateAsync">
    @* Dentro do modal: com o formulário aberto, uma faixa de erro atrás dele não seria vista. *@
    <AdminFeedback Result="_erroDoModal" />

    <div class="campo">
        <label class="campo__rotulo" for="tpl-nome">Nome</label>
        <input id="tpl-nome" class="campo__controle" data-testid="template-name" @bind="_nomeTemplate" />
    </div>

    <div class="linha">
        <div class="campo" style="flex:0 1 120px">
            <label class="campo__rotulo" for="tpl-ordem">Ordem</label>
            <input id="tpl-ordem" class="campo__controle" type="number" @bind="_ordemTemplate" />
        </div>
        <Caixa @bind-Value="_templateAtivo" Label="Ativo" />
    </div>

    @*
        Os setores precisam estar aqui. Antes a tela enviava sempre uma lista vazia, e como lista
        vazia significa "vale para todos", editar o nome de um tipo apagava em silêncio a
        restrição que o administrador havia configurado.
    *@
    <div class="campo">
        <span class="campo__rotulo">Setores</span>
        <span class="campo__ajuda">Nenhum marcado: o tipo vale para todos os setores, inclusive os criados depois.</span>

        @foreach (var setor in _setores)
        {
            <Caixa Value="@_setoresDoTemplate.Contains(setor.Id)"
                   ValueChanged="marcada => AlternarSetor(setor.Id, marcada)"
                   Label="@setor.Name"
                   TestId="@($"template-sector-{setor.Id}")" />
        }
    </div>
</FormDialog>

<FormDialog @bind-Visible="_modalColuna"
            Wide="true"
            Title="@_tituloDaColuna"
            Saving="_salvando"
            OnSave="SalvarColunaAsync">
    <AdminFeedback Result="_erroDoModal" />

    <fieldset class="admin-formulario-grupo">
        <legend>Identificação e horário</legend>
        <div class="linha">
            <div class="campo" style="flex:1 1 160px">
                <label class="campo__rotulo" for="col-nome">Nome exibido</label>
                <input id="col-nome" class="campo__controle" data-testid="column-name" @bind="_nomeColuna" />
            </div>
            <div class="campo" style="flex:0 1 140px">
                <label class="campo__rotulo" for="col-hora">Horário real</label>
                <input id="col-hora" class="campo__controle" type="time" data-testid="column-time" @bind="_horaColuna" />
                <span class="campo__ajuda">Sem horário, a coluna não gera notificação.</span>
            </div>
            <div class="campo" style="flex:0 1 100px">
                <label class="campo__rotulo" for="col-ordem">Ordem</label>
                <input id="col-ordem" class="campo__controle" type="number" @bind="_ordemColuna" />
            </div>
        </div>
        <Caixa @bind-Value="_colunaAtiva" Label="Coluna ativa" />
    </fieldset>

    <fieldset class="admin-formulario-grupo">
        <legend>Notificação</legend>
        <Caixa @bind-Value="_notificar" Label="Notificar no horário" TestId="column-notify" />

        @if (_notificar)
        {
            <div class="linha" data-testid="notification-options">
                <div class="campo" style="flex:0 1 160px">
                    <label class="campo__rotulo" for="col-antecedencia">Antecedência (min) <HelpPopover Label="Ajuda sobre antecedência">Dispara um aviso antes do horário principal.</HelpPopover></label>
                    <input id="col-antecedencia" class="campo__controle" type="number" min="0" @bind="_antecedencia" />
                </div>
                <div class="campo" style="flex:0 1 160px">
                    <label class="campo__rotulo" for="col-tolerancia">Tolerância (min) <HelpPopover Label="Ajuda sobre tolerância">Após este período, a coluna passa a ser considerada atrasada.</HelpPopover></label>
                    <input id="col-tolerancia" class="campo__controle" type="number" min="0" @bind="_tolerancia" />
                </div>
            </div>
        }
    </fieldset>

    @if (_notificar)
    {
        <fieldset class="admin-formulario-grupo" data-testid="repeat-options">
            <legend>Repetição e adiamento</legend>
            <div class="linha">
                <div class="campo" style="flex:0 1 180px">
                    <label class="campo__rotulo" for="col-intervalo">Intervalo (min) <HelpPopover Label="Ajuda sobre repetição">Tempo entre os lembretes enquanto houver pendências.</HelpPopover></label>
                    <input id="col-intervalo" class="campo__controle" type="number" min="0" @bind="_intervalo" />
                </div>
                <div class="campo" style="flex:0 1 170px">
                    <label class="campo__rotulo" for="col-repeticoes">Máximo de repetições</label>
                    <input id="col-repeticoes" class="campo__controle" type="number" min="0" @bind="_repeticoes" />
                </div>
            </div>
            <Caixa @bind-Value="_permitirAdiar" Label="Permitir adiar" TestId="column-snooze" />
            @if (_permitirAdiar)
            {
                <div class="campo" style="max-width:220px" data-testid="snooze-options">
                    <label class="campo__rotulo" for="col-adiar">Minutos do adiamento <HelpPopover Label="Ajuda sobre adiamento">Intervalo oferecido ao tocar em adiar no alerta.</HelpPopover></label>
                    <input id="col-adiar" class="campo__controle" type="number" min="1" @bind="_minutosAdiar" />
                </div>
            }
        </fieldset>
    }
</FormDialog>

<LoadingOverlay Visible="_carregando" Message="Carregando os tipos de checklist…" />

@code {
    private bool _carregando;

    private IReadOnlyList<ChecklistTemplateDto> _templates = [];
    private IReadOnlyList<SectorDto> _setores = [];
    private Result? _resultado;

    private ChecklistTemplateDto? _templateEditando;
    private string _nomeTemplate = string.Empty;
    private int _ordemTemplate = 10;
    private bool _templateAtivo = true;
    private readonly HashSet<Guid> _setoresDoTemplate = [];

    private ChecklistTemplateDto? _templateDaColuna;
    private ChecklistColumnDto? _colunaEditando;
    private string _nomeColuna = string.Empty;
    private TimeOnly? _horaColuna;
    private int _ordemColuna = 10;
    private bool _notificar = true;
    private bool _colunaAtiva = true;
    private bool _permitirAdiar = true;
    private int _antecedencia;
    private int _tolerancia = 15;
    private int _intervalo = 10;
    private int _repeticoes = 3;
    private int _minutosAdiar = 5;

    private bool _modalTemplate;
    private bool _modalColuna;
    private bool _salvando;
    private Result? _erroDoModal;

    private string _tituloDaColuna => _colunaEditando is null
        ? $"Nova coluna em {_templateDaColuna?.Name}"
        : $"Editando a coluna {_colunaEditando.DisplayName}";

    protected override async Task OnInitializedAsync() => await CarregarAsync();

    private async Task CarregarAsync()
    {
        _carregando = true;

        try
        {
            _templates = await Admin.GetTemplatesAsync();
            _setores = await Admin.GetSectorsAsync();
        }
        finally
        {
            _carregando = false;
        }
    }

    private void NovoTemplate()
    {
        _templateEditando = null;
        _nomeTemplate = string.Empty;
        _ordemTemplate = (_templates.Count + 1) * 10;
        _templateAtivo = true;
        _setoresDoTemplate.Clear();
        LimparAvisos();
        _modalTemplate = true;
    }

    private void EditarTemplate(ChecklistTemplateDto template)
    {
        _templateEditando = template;
        _nomeTemplate = template.Name;
        _ordemTemplate = template.SortOrder;
        _templateAtivo = template.IsActive;

        // Carregar os setores atuais é o que impede a edição de apagá-los.
        _setoresDoTemplate.Clear();
        foreach (var id in template.SectorIds)
        {
            _setoresDoTemplate.Add(id);
        }

        LimparAvisos();
        _modalTemplate = true;
    }

    private void AlternarSetor(Guid sectorId, bool marcado)
    {
        if (marcado)
        {
            _setoresDoTemplate.Add(sectorId);
        }
        else
        {
            _setoresDoTemplate.Remove(sectorId);
        }
    }

    private void NovaColuna(ChecklistTemplateDto template)
    {
        _templateDaColuna = template;
        _colunaEditando = null;
        _nomeColuna = string.Empty;
        _horaColuna = null;
        _ordemColuna = (template.Columns.Count + 1) * 10;
        _notificar = true;
        _colunaAtiva = true;
        _permitirAdiar = true;
        _antecedencia = 0;
        _tolerancia = 15;
        _intervalo = 10;
        _repeticoes = 3;
        _minutosAdiar = 5;
        LimparAvisos();
        _modalColuna = true;
    }

    private void EditarColuna(ChecklistTemplateDto template, ChecklistColumnDto coluna)
    {
        _templateDaColuna = template;
        _colunaEditando = coluna;
        _nomeColuna = coluna.DisplayName;
        _horaColuna = coluna.TriggerTime;
        _ordemColuna = coluna.SortOrder;
        _notificar = coluna.NotificationEnabled;
        _colunaAtiva = coluna.IsActive;
        _permitirAdiar = coluna.AllowSnooze;
        _antecedencia = coluna.LeadTimeMinutes;
        _tolerancia = coluna.GracePeriodMinutes;
        _intervalo = coluna.RepeatIntervalMinutes;
        _repeticoes = coluna.MaximumRepeats;
        _minutosAdiar = coluna.SnoozeMinutes;
        LimparAvisos();
        _modalColuna = true;
    }

    private void LimparAvisos()
    {
        _erroDoModal = null;
        _resultado = null;
    }

    private async Task SalvarTemplateAsync()
    {
        _salvando = true;

        try
        {
            var resultado = await Admin.SaveTemplateAsync(
                _templateEditando?.Id,
                new SaveTemplateRequest(
                    _nomeTemplate,
                    null,
                    _ordemTemplate,
                    _templateAtivo,
                    [.. _setoresDoTemplate],
                    _templateEditando?.Version ?? 0));

            if (!resultado.Succeeded)
            {
                // Modal aberto de propósito: o que foi digitado continua ali para ser corrigido.
                _erroDoModal = resultado;
                return;
            }

            _resultado = resultado;
            _modalTemplate = false;
            await CarregarAsync();
        }
        finally
        {
            _salvando = false;
        }
    }

    private async Task SalvarColunaAsync()
    {
        if (_templateDaColuna is null)
        {
            return;
        }

        _salvando = true;

        try
        {
            var resultado = await Admin.SaveColumnAsync(
                _templateDaColuna.Id,
                _colunaEditando?.Id,
                new SaveColumnRequest(
                    _nomeColuna,
                    _horaColuna,
                    _ordemColuna,
                    _colunaAtiva,
                    _notificar,
                    _antecedencia,
                    _tolerancia,
                    _intervalo,
                    _repeticoes,
                    _permitirAdiar,
                    _minutosAdiar,
                    _colunaEditando?.Version ?? 0));

            if (!resultado.Succeeded)
            {
                _erroDoModal = resultado;
                return;
            }

            _resultado = resultado;
            _modalColuna = false;
            await CarregarAsync();
        }
        finally
        {
            _salvando = false;
        }
    }
}
