@page "/admin/notificacoes"

@inject ISystemAdminService Admin

<PageTitle>Notificações</PageTitle>

<AdminPageHeader Title="Notificações"
                 Description="Configure onde os alertas aparecem, seu conteúdo e o comportamento nos celulares."
                 BackHref="/admin/avancado" />

<AdminFeedback Result="_resultado" />

@if (_notificacoes is null)
{
    <LoadingState Message="Carregando as configurações de notificação…" />
}
else
{
    <div class="admin-configuracoes">
        <fieldset class="cartao admin-formulario-grupo" data-testid="notification-channels">
            <legend>Canais e comportamento</legend>
            <p class="campo__ajuda">Escolha as plataformas que recebem alertas e como o aparelho chama a atenção.</p>
            <div class="linha">
                <Caixa @bind-Value="_android" Label="Habilitado no Android e iPhone" TestId="notif-android" />
                <Caixa @bind-Value="_windows" Label="Habilitado no Windows" TestId="notif-windows" />
                <Caixa @bind-Value="_som" Label="Som" TestId="notif-sound" />
                <Caixa @bind-Value="_vibracao" Label="Vibração" TestId="notif-vibration" />
            </div>

            <div class="campo" style="max-width:220px">
                <div class="linha">
                    <label class="campo__rotulo" for="prioridade">Prioridade</label>
                    <HelpPopover Label="Ajuda sobre a prioridade">Prioridades mais altas ganham destaque, mas ainda respeitam os ajustes de notificação do sistema operacional.</HelpPopover>
                </div>
                <select id="prioridade" class="campo__controle" @bind="_prioridade">
                    <option value="Normal">Normal</option>
                    <option value="High">Alta</option>
                    <option value="Urgent">Urgente</option>
                </select>
            </div>
        </fieldset>

        <fieldset class="cartao admin-formulario-grupo" data-testid="notification-content">
            <legend>Conteúdo do alerta</legend>
            <div class="campo">
                <div class="linha">
                    <label class="campo__rotulo" for="titulo">Modelo do título</label>
                    <HelpPopover Label="Ajuda sobre os marcadores do título">Use {checklist}, {coluna}, {setor} e {pendentes}; eles serão substituídos ao criar cada alerta.</HelpPopover>
                </div>
                <input id="titulo" class="campo__controle" data-testid="notif-title" @bind="_titulo" />
            </div>

            <div class="campo">
                <label class="campo__rotulo" for="corpo">Modelo da mensagem</label>
                <input id="corpo" class="campo__controle" data-testid="notif-body" @bind="_corpo" />
            </div>
        </fieldset>

        <fieldset class="cartao admin-formulario-grupo" data-testid="notification-android-options">
            <legend>Opções avançadas do Android</legend>
            <div class="linha">
                <Caixa @bind-Value="_telaCheia" Label="Permitir alerta em tela cheia" TestId="notif-full-screen" />
                <HelpPopover Label="Ajuda sobre alertas em tela cheia">Essa permissão é intrusiva e sujeita a restrições da loja. Mantenha desligada, salvo quando a instituição realmente precisar interromper a tela atual.</HelpPopover>
            </div>
        </fieldset>

        <button type="button" class="botao botao--primario" data-testid="notif-save" @onclick="SalvarAsync">
            Salvar notificações
        </button>
    </div>
}

@code {
    private NotificationConfigurationDto? _notificacoes;
    private Result? _resultado;

    private bool _som, _vibracao, _android, _windows, _telaCheia;
    private string _prioridade = "High";
    private string _titulo = string.Empty;
    private string _corpo = string.Empty;

    protected override async Task OnInitializedAsync() => await CarregarAsync();

    private async Task CarregarAsync()
    {
        _notificacoes = await Admin.GetNotificationConfigurationAsync();
        _som = _notificacoes.SoundEnabled;
        _vibracao = _notificacoes.VibrationEnabled;
        _android = _notificacoes.EnabledOnAndroid;
        _windows = _notificacoes.EnabledOnWindows;
        _telaCheia = _notificacoes.AllowFullScreenIntent;
        _prioridade = _notificacoes.Priority;
        _titulo = _notificacoes.TitleTemplate;
        _corpo = _notificacoes.BodyTemplate;
    }

    private async Task SalvarAsync()
    {
        _resultado = await Admin.SaveNotificationConfigurationAsync(new SaveNotificationConfigurationRequest(
            _som, _vibracao, _prioridade, _android, _windows, _telaCheia, _titulo, _corpo, _notificacoes?.Version ?? 0));

        if (_resultado.Succeeded)
        {
            await CarregarAsync();
        }
    }
}
