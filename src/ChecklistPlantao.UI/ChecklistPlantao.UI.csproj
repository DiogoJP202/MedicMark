<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Razor Class Library compartilhada entre os heads Android, iOS e Windows.
    Só conhece os contratos de Client.Abstractions — nada de EF Core, HttpClient ou MAUI aqui.
    Isso mantém a RCL testável com bUnit em net10.0 puro.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ChecklistPlantao.UI</RootNamespace>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
    <StaticWebAssetBasePath>_content/ChecklistPlantao.UI</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChecklistPlantao.Contracts\ChecklistPlantao.Contracts.csproj" />
    <ProjectReference Include="..\ChecklistPlantao.Domain\ChecklistPlantao.Domain.csproj" />
    <!-- Os contratos que a RCL consome vivem fora dela, para o núcleo do cliente poder
         implementá-los sem depender de componentes visuais. Ver docs/DECISIONS.md (D-023). -->
    <ProjectReference Include="..\ChecklistPlantao.Client.Abstractions\ChecklistPlantao.Client.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
  </ItemGroup>

</Project>
