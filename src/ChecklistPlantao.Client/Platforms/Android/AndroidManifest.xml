<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    networkSecurityConfig: exige HTTPS com certificado emitido por uma autoridade pública.
    Ver Resources/xml/network_security_config.xml.
  -->
  <application android:allowBackup="true"
               android:icon="@mipmap/appicon"
               android:supportsRtl="true"
               android:networkSecurityConfig="@xml/network_security_config"></application>

  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.INTERNET" />

  <!-- Notificações: obrigatória a partir do Android 13, pedida em tempo de execução. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!-- Reagendar os alarmes depois que o aparelho reinicia. Sem isto, um celular reiniciado
       durante a madrugada perderia todos os horários restantes do plantão. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <!-- Alarme no horário exato. SCHEDULE_EXACT_ALARM depende de autorização do usuário; sem ela,
       o aplicativo usa alarme inexato e AVISA que o horário pode não ser exato.
       USE_EXACT_ALARM não é declarado: a Play Store o restringe a despertadores e calendários. -->
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

  <!-- Vibração no alerta. -->
  <uses-permission android:name="android.permission.VIBRATE" />

</manifest>
