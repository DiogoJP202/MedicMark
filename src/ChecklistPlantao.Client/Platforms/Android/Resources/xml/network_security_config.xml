<?xml version="1.0" encoding="utf-8"?>
<!--
    Política de rede do aplicativo.

    A distribuição Android oficial acessa o servidor de produção somente por HTTPS. Tráfego em
    texto claro fica bloqueado mesmo se um endereço HTTP for informado manualmente.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Autoridades públicas do sistema. -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
