<Project Sdk="Microsoft.NET.Sdk.Razor">

    <!--
        Head MAUI Blazor Hybrid para Android, iOS e Windows. O código iOS pode ser
        restaurado e verificado no Windows, mas a compilação nativa e a assinatura
        dependem de um Mac com Xcode. Ver docs/IOS_SETUP.md.

        ManagePackageVersionsCentrally=false: o SDK do MAUI injeta PackageReference
        implícitos usando $(MauiVersion), o que conflita com Central Package
        Management. Ver docs/DECISIONS.md (D-006).
    -->
    <PropertyGroup>
        <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <RootNamespace>ChecklistPlantao.Client</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <ApplicationTitle>Checklist de Plantão</ApplicationTitle>
        <ApplicationId>br.com.checklistplantao.app</ApplicationId>

        <ApplicationDisplayVersion>0.1.2</ApplicationDisplayVersion>
        <ApplicationVersion>3</ApplicationVersion>

        <!-- Desempacotado no Windows: build MSIX exige o Windows 10 SDK. Ver docs/WINDOWS_SETUP.md. -->
        <WindowsPackageType>None</WindowsPackageType>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <ItemGroup>
        <MauiIcon Include="Resources\AppIcon\appicon.svg"
                  ForegroundFile="Resources\AppIcon\medicmark_icon_v2.png"
                  ForegroundScale="0.70"
                  BaseSize="128,128"
                  Color="#0F3D5C" />
        <MauiSplashScreen Include="Resources\AppIcon\medicmark_icon_v2.png"
                          Color="#0F3D5C"
                          BaseSize="256,256" />
        <MauiImage Include="Resources\Images\*" />
        <MauiFont Include="Resources\Fonts\*" />
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ChecklistPlantao.UI\ChecklistPlantao.UI.csproj" />
        <ProjectReference Include="..\ChecklistPlantao.Client.Core\ChecklistPlantao.Client.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.10" />

        <!--
            Correção de segurança GHSA-2m69-gcr7-jv3q (SQLite vulnerável em <= 2.1.11).
            Precisa ser declarada aqui: este projeto tem Central Package Management desligado
            (ver o comentário no topo), então os pinos de Directory.Packages.props não o alcançam.
        -->
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
        <PackageReference Include="SQLitePCLRaw.core" Version="2.1.12" />
        <PackageReference Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.12" />
    </ItemGroup>

    <!--
        A biblioteca nativa é escolhida por plataforma. Referenciar as duas ao mesmo tempo faz o
        empacotador do Android encontrar libe_sqlite3.so em duas origens (aviso XA4301).
    -->
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.12" />
    </ItemGroup>

    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'">
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    </ItemGroup>

    <!--
        Um Release sem chave própria recebe a chave de debug do SDK e parece distribuível por
        terminar em "-Signed". Impedir Publish nesse estado evita criar uma identidade Android
        descartável por engano. O build comum continua livre; a publicação oficial passa pelo
        deploy/mobile/publish-android.ps1.
    -->
    <Target Name="RequireAndroidReleaseSigning"
            BeforeTargets="Publish"
            Condition="'$(TargetFramework)' == 'net10.0-android' and '$(Configuration)' == 'Release' and '$(AndroidKeyStore)' != 'true'">
        <Error Text="Publicação Android Release exige uma chave própria. Use deploy/mobile/publish-android.ps1." />
    </Target>

</Project>
