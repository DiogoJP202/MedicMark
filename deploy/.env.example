# Copie para deploy/.env e preencha. O arquivo .env NÃO é versionado (ver .gitignore).
# Nenhum valor real deve ser commitado neste arquivo de exemplo.

# Porta local usada pelo Nginx. O compose a vincula somente a 127.0.0.1.
SERVER_PORT=8080
ALLOWED_HOSTS=163.176.119.139
PRIVACY_SUPPORT_URL=https://github.com/DiogoJP202/MedicMark/issues

# Chave de assinatura do JWT. Mínimo 32 caracteres; use algo aleatório e exclusivo.
# Gerar no Linux/macOS:  openssl rand -base64 48
# Gerar no PowerShell:   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SIGNING_KEY=

JWT_ISSUER=ChecklistPlantao
JWT_AUDIENCE=ChecklistPlantao.Client

# Administrador inicial. Só é usado na PRIMEIRA execução, enquanto não existe nenhum usuário.
# Depois de criado, remova estes valores e troque a senha pelo painel administrativo.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAYNAME=Administrador
